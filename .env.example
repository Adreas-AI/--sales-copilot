# Copy to .env and adjust. Never commit .env (it is git-ignored).
# Everything works without an OpenAI key: rule-based scoring and template emails.

# --- Application -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Without Docker, sqlite:///./copilot.db works for quick experiments.
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
# Optional shared secret for internal endpoints (sent as X-API-Key). It is baked into
# the dashboard bundle, so in production put the dashboard behind SSO instead.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Base URL used for unsubscribe links in outgoing emails.
PUBLIC_BASE_URL=http://localhost:8080

# --- Secrets (change these) --------------------------------------------------------
WEBHOOK_SECRET=change-me-webhook-secret
UNSUBSCRIBE_SECRET=change-me-unsubscribe-secret

# --- AI (optional) -----------------------------------------------------------------
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The AI may move a rule score by at most this many points, and only with quoted evidence.
AI_MAX_ADJUSTMENT=15

# --- Qualification -------------------------------------------------------------------
HOT_THRESHOLD=70
WARM_THRESHOLD=40

# --- Follow-up cadence ---------------------------------------------------------------
# Days after the inquiry on which follow-up drafts are prepared; then manual review.
FOLLOWUP_STEP_DAYS=2,5
MANUAL_REVIEW_DAY=10
FOLLOWUP_TEMPERATURES=hot,warm
DRAFT_REVIEW_SLA_HOURS=24
UNANSWERED_AFTER_HOURS=4

# --- Outbound email --------------------------------------------------------------------
SENDER_NAME=Maya Chen
SENDER_TITLE=Account Executive
SENDER_EMAIL=maya@bookflow.example
# log = write to the log instead of sending; smtp = send through SMTP_* below
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Worker -----------------------------------------------------------------------------
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=10
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=5

# --- Docker Compose host ports ----------------------------------------------------------
DB_PORT=5432
API_PORT=8000
DASHBOARD_PORT=8080
